__pycache__/
*.py[cod]
.pytest_cache/
# hypothesis writes a failure database here so a property test that
# fails once replays that exact input first next time. Useful locally,
# machine-specific, never committed.
.hypothesis/
.coverage
htmlcov/

# `tools/smu_checkup.py --out` defaults to ./checkups, so a bench
# commissioning run drops a Markdown report and a JSON sidecar into the
# working tree. Untracked, one absent-minded `git add -A` from being
# committed, and it has already wedged a `git stash -u` on Windows.
#
# It is the only tool that writes into the tree: `make_goldens.py`
# writes tests/golden/, which is tracked and meant to be. The other
# three write nothing.
checkups/
# No trailing slash on .venv: `.venv/` matches a directory only, so a
# *symlink* named .venv is not ignored by it. That is how a link to a
# virtualenv outside the tree once reached a delivered patch.
.venv
venv/
build/
dist/
*.egg-info/
*.log

# Wave deliverables arrive as patches applied with `git apply`, and the
# working protocol says they are not committed. Until now that was a
# convention rather than a rule the tree enforced, so a `git add -A`
# after applying one would have committed it.
*.patch
*.diff
probes/

# Instrument manuals are copied in by hand rather than committed: the
# set runs to hundreds of megabytes, and git history is permanent, so
# every bench machine and every CI job would pay for them on every
# clone forever. The parts that are load-bearing - command summary and
# reset-default tables - are extracted to docs/reference/manuals/ as
# Markdown, which is greppable and diffable in a way a PDF is not.
# manuals/README.md says what should be there. See docs/reference/schema.md.
manuals/*
!manuals/README.md

# Obsidian's vault configuration is per-person. The vault is an optional
# way to read docs/, not the intended one - the repository is read on
# GitHub - so the config is nobody else's business, and workspace.json
# in particular would conflict on every pull.
.obsidian/
